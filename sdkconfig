# ESP32-S3 SDK Configuration for Weather Station Firmware

# Chip settings
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y

# Enable SPIFFS
CONFIG_SPIFFS_FORMAT_ON_MOUNT_FAIL=y
CONFIG_SPIFFS_PAGE_CHECK=y
CONFIG_SPIFFS_GC_MAX_RUNS=800
CONFIG_SPIFFS_CACHE_STATS=y
CONFIG_SPIFFS_CACHE_SIZE=16384
CONFIG_SPIFFS_LOG_BLOCK_SIZE=4096
CONFIG_SPIFFS_LOG_PAGE_SIZE=256
CONFIG_SPIFFS_META_LENGTH=4

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# WiFi
CONFIG_ESP_WIFI_AUTH_WPA2_PSK=y
CONFIG_ESP_WIFI_AUTH_WPA3_PSK=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL=3

# FreeRTOS
CONFIG_FREERTOS_ENABLE_STATIC_TASK_CLEAN_UP=y
CONFIG_FREERTOS_TASK_FUNCTION_WRAPPER=y

# Memory
CONFIG_ESP32S3_INSTRUCTION_CACHE_SIZE=32
CONFIG_ESP32S3_INSTRUCTION_CACHE_LINE_SIZE=32
CONFIG_ESP32S3_DATA_CACHE_SIZE=32
CONFIG_ESP32S3_DATA_CACHE_LINE_SIZE=32
CONFIG_ESP32S3_DATA_CACHE_8KB=y

# UART
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_UART_ISR_IN_IRAM=y

# SSL/TLS (optional, for secure MQTT)
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# Network
CONFIG_LWIP_DHCP_DOES_ARP_CHECK=y
CONFIG_LWIP_NETIF_LOOPBACK=y

# Debug
CONFIG_ESP_ERR_TO_NAME_LOOKUP=y
CONFIG_IDF_CMAKE_WARNINGS_AS_ERRORS=n
